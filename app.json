        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mansijain03.spillr"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6afa32ee-59a4-40f3-8458-4fb19d2bf5f4"
      }
    }
  }
}
