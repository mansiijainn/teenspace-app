{
  "expo": {
    "name": "spillr",
    "slug": "spillr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spillr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
